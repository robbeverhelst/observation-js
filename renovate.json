{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommitTypeAll(chore)",
    "helpers:pinGitHubActionDigests"
  ],
  "osvVulnerabilityAlerts": true,
  "lockFileMaintenance": {
    "enabled": true
  },
  "timezone": "UTC",
  "schedule": [
    "after 1am and before 7am every weekend"
  ],
  "labels": [
    "dependencies",
    "automated"
  ],
  "prConcurrentLimit": 0,
  "prHourlyLimit": 0,
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "description": "Auto-merge patch updates",
      "matchUpdateTypes": [
        "patch"
      ],
      "automerge": true
    },
    {
      "description": "Hold TypeScript 7 (native compiler, no JS API) until typedoc's peer range supports it",
      "matchPackageNames": [
        "typescript"
      ],
      "matchDepTypes": [
        "devDependencies"
      ],
      "allowedVersions": "<7.0.0"
    }
  ]
}
