{
  "name": "observation-js",
  "version": "2.0.0",
  "description": "A fully-typed TypeScript client for the waarneming.nl API.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/robbeverhelst/observation-js.git"
  },
  "homepage": "https://github.com/robbeverhelst/observation-js#readme",
  "bugs": {
    "url": "https://github.com/robbeverhelst/observation-js/issues"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "packageManager": "bun@1.4.3",
  "type": "module",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "ci": "bun run check:bun-native && bun run check:lint && bun run check:format && bun run build && bun test",
    "build": "tsc",
    "test": "bun test",
    "check:bun-native": "bun run scripts/check-bun-native.ts",
    "test:integration": "bun test tests/integration/",
    "test:e2e": "bun test tests/e2e/",
    "check:lint": "bunx bun@1.4.3-canary.20261014.1 lint src",
    "format": "bunx bun@1.4.3-canary.20261014.1 fmt",
    "check:format": "bunx bun@1.4.3-canary.20261014.1 fmt --check",
    "examples": "bun run examples/test-all.ts",
    "docs:generate": "typedoc"
  },
  "devDependencies": {
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/github": "^12.0.8",
    "@semantic-release/npm": "^13.1.5",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/bun": "^1.3.14",
    "bun-types": "^1.3.14",
    "semantic-release": "^25.0.5",
    "typedoc": "^0.28.19",
    "typedoc-material-theme": "^1.4.1"
  },
  "peerDependencies": {
    "typescript": "^5.0.0 || ^6.0.0"
  },
  "keywords": [
    "observation",
    "waarneming.nl",
    "waarnemingen.be",
    "observation.org",
    "api",
    "client"
  ],
  "author": "Robbe Verhelst",
  "license": "MIT",
  "dependencies": {
    "form-data-encoder": "^4.1.0"
  }
}
